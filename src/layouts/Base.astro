---
import header from '../site/shared/header.html?raw';
import footer from '../site/shared/footer.html?raw';
import extras from '../site/shared/extras.html?raw';
import globalCss from '../site/shared/global.css?raw';
import fontsCss from '../site/shared/fonts.css?raw';
import preloadFonts from '../site/shared/preload-fonts.json';

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  path: string;
  pageCss: string;
  fullCss: string | null;
  pageJs: string | null;
  lcp: string | null;
  lcpMobile: string | null;
  lcpCss: string | null;
  ext: string[];
}
const { title, description, bodyClass, path, pageCss, fullCss, pageJs, lcp, lcpMobile, lcpCss, ext } = Astro.props;
const base = import.meta.env.BASE_URL;
const favicon = `${base}wp-content/uploads/2026/05/cropped-favicon-roze`;
const swiper = ext.some((s) => s.includes('swiper'));
const scripts = [`${base}js/runtime.js`, ...(swiper ? [`${base}js/swiper-bundle.min.js`] : []), `${base}js/site.js`, ...(pageJs ? [pageJs] : [])];
---
<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Interne snelheidsdemo: niet indexeren, canonical naar de echte site -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={`https://www.daar-om.nl${path}`} />
    <link rel="icon" href={`${favicon}-32x32.png`} sizes="32x32" />
    <link rel="icon" href={`${favicon}-192x192.png`} sizes="192x192" />
    <link rel="apple-touch-icon" href={`${favicon}-180x180.png`} />
    {lcp && lcpMobile && <link rel="preload" as="image" href={lcpMobile} fetchpriority="high" media="(max-width: 767px)" />}
    {lcp && <link rel="preload" as="image" href={lcp} fetchpriority="high" media={lcpMobile ? '(min-width: 768px)' : undefined} />}
    {preloadFonts.map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    <style is:inline set:html={fontsCss}></style>
    <style is:inline set:html={globalCss}></style>
    <style is:inline set:html={pageCss + (lcpCss || '')}></style>
    {fullCss && (
      <>
        <!-- Kritieke CSS staat inline, de rest laadt zonder het renderen te blokkeren -->
        <link rel="stylesheet" href={fullCss} media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href={fullCss} /></noscript>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <div id="page-container">
      <div id="et-boc" class="et-boc">
        <Fragment set:html={header} />
        <div id="et-main-area">
          <slot />
          <Fragment set:html={footer} />
        </div>
      </div>
    </div>
    <Fragment set:html={extras} />
    <!-- Scripts pas na de eerste paint laden: niets in het kritieke pad -->
    <script is:inline define:vars={{ scripts }}>
      (function () {
        var d = document, w = window, dAdd = d.addEventListener, wAdd = w.addEventListener;
        function run() {
          // Scripts die op DOMContentLoaded/load wachten, direct laten draaien
          d.addEventListener = function (t, f, o) { if (t === 'DOMContentLoaded') { setTimeout(f, 0); return; } return dAdd.call(d, t, f, o); };
          w.addEventListener = function (t, f, o) { if (t === 'load' && d.readyState === 'complete') { setTimeout(f, 0); return; } return wAdd.call(w, t, f, o); };
          var i = 0;
          (function next() {
            if (i >= scripts.length) return;
            var e = d.createElement('script');
            e.src = scripts[i++];
            e.onload = e.onerror = next;
            d.body.appendChild(e);
          })();
        }
        function afterPaint() { requestAnimationFrame(function () { setTimeout(run, 0); }); }
        if (d.readyState === 'loading') dAdd.call(d, 'DOMContentLoaded', afterPaint); else afterPaint();
      })();
    </script>
  </body>
</html>
