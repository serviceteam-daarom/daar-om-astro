---
// Lichte layout voor de herbouwde homepage: geen Divi-markup, geen Divi-CSS.
import header from './parts/header.html?raw';
import search from './parts/search.html?raw';
import fontsCss from './build/fonts.css?raw';
import homeCss from './build/home.critical.css?raw';
import Footer from './components/Footer.astro';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
// Afbeeldingen buiten het eerste scherm (en de logostrook) pas na de eerste weergave laden:
// src wordt data-src, home.js zet ze terug zodra ze in de buurt komen.
const pixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const deferImgs = (html: string) =>
  html.replace(/<img\b([^>]*?)>/g, (tag, attrs) => {
    if (!/loading="(lazy|eager)"/.test(attrs) || /hm-logo|data-src/.test(attrs)) return tag;
    return '<img' + attrs.replace(/\ssrc="/, ` src="${pixel}" data-src="`).replace(/\ssrcset="/, ' data-srcset="') + '>';
  });
const main = deferImgs(await Astro.slots.render('default'));
const base = import.meta.env.BASE_URL;
const favicon = `${base}wp-content/uploads/2026/05/cropped-favicon-roze`;
const hero = `${base}wp-content/uploads/2026/05/martini-toren1`;
const homeJs = `${base}js/home.js`;
const lateJs = [`${base}js/runtime.js`, `${base}js/site.js`];
const fullCss = `${base}css/home.css`;
---
<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://www.daar-om.nl/" />
    <link rel="icon" href={`${favicon}-32x32.png`} sizes="32x32" />
    <link rel="icon" href={`${favicon}-192x192.png`} sizes="192x192" />
    <link rel="apple-touch-icon" href={`${favicon}-180x180.png`} />
    <link rel="preload" as="image" href={`${hero}-m.webp`} fetchpriority="high" media="(max-width: 767px)" />
    <link rel="preload" as="image" href={`${hero}.webp`} fetchpriority="high" media="(min-width: 768px)" />
    <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/poppins-500-latin.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/poppins-700-latin.woff2`} crossorigin />
    <style is:inline set:html={fontsCss}></style>
    <style is:inline set:html={homeCss}></style>
    <!-- Kritieke CSS staat inline; de rest laadt zonder het renderen op te houden -->
    <noscript><link rel="stylesheet" href={`${base}css/home.css`} /></noscript>
    <style is:inline set:html={`:root{--hero-d:url(${hero}.webp)}@media (max-width:767px){:root{--hero-d:url(${hero}-m.webp)}}`}></style>
  </head>
  <body class="home-v2">
    <header class="site-header"><Fragment set:html={header} /></header>
    <main id="main-content">
      <Fragment set:html={main} />
    </main>
    <Footer />
    <Fragment set:html={search} />
    <script is:inline define:vars={{ homeJs, lateJs, fullCss }}>
      (function () {
        var d = document, w = window, dAdd = d.addEventListener, wAdd = w.addEventListener;
        function run() {
          // Menu- en zoekpaneel uit hun <template> halen voordat de scripts starten
          ['hm-mob-tpl', 'do-s-tpl'].forEach(function (id) { var t = d.getElementById(id); if (t) t.replaceWith(t.content); });
          // Rest van de CSS bij de eerste interactie (scrollen, aanraken, toets) of na 10 s rust.
          // De kritieke CSS dekt het eerste scherm al volledig.
          var cssDone = false, evts = ['scroll', 'pointerdown', 'pointermove', 'keydown', 'touchstart', 'wheel'];
          function loadCss() {
            if (cssDone) return; cssDone = true;
            evts.forEach(function (e) { w.removeEventListener(e, loadCss, true); });
            var css = d.createElement('link'); css.rel = 'stylesheet'; css.href = fullCss; d.head.appendChild(css);
          }
          evts.forEach(function (e) { wAdd.call(w, e, loadCss, { capture: true, passive: true }); });
          if (d.readyState === 'complete') setTimeout(loadCss, 10000); else wAdd.call(w, "load", function () { setTimeout(loadCss, 10000); });
          d.addEventListener = function (t, f, o) { if (t === 'DOMContentLoaded') { setTimeout(f, 0); return; } return dAdd.call(d, t, f, o); };
          w.addEventListener = function (t, f, o) { if (t === 'load' && d.readyState === 'complete') { setTimeout(f, 0); return; } return wAdd.call(w, t, f, o); };
          // home.js (lazy laden, sliders) direct; header- en zoekscripts bij de eerste interactie
          function load(list, done) {
            var i = 0;
            (function next() {
              if (i >= list.length) { if (done) done(); return; }
              var e = d.createElement('script');
              e.src = list[i++];
              e.onload = e.onerror = next;
              d.body.appendChild(e);
            })();
          }
          load([homeJs]);
          var pending = null;
          wAdd.call(w, 'click', function (e) {
            if (window.__daaromReady) return;
            var t = e.target.closest('a, button, label');
            if (t && t.querySelector('.fa-magnifying-glass, .fa-search')) { e.preventDefault(); pending = t; }
          }, true);
          function loadRest() {
            if (window.__daaromRest) return; window.__daaromRest = true;
            load(lateJs, function () { window.__daaromReady = true; if (pending) pending.click(); });
          }
          evts.forEach(function (e) { wAdd.call(w, e, loadRest, { capture: true, passive: true, once: true }); });
          setTimeout(loadRest, 10000);
        }
        function afterPaint() { requestAnimationFrame(function () { setTimeout(run, 0); }); }
        if (d.readyState === 'loading') dAdd.call(d, 'DOMContentLoaded', afterPaint); else afterPaint();
      })();
    </script>
  </body>
</html>
